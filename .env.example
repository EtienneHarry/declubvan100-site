# Omgevingsvariabelen voor de admin en het formulier.
#
# Dit bestand staat wél in git en bevat daarom geen waardes. Kopieer het naar
# .env en vul dat in; .env en alle varianten erop worden genegeerd.
#
# Lokaal hoeft er niets in. Zonder deze variabelen draait de admin in local mode
# en schrijft hij rechtstreeks naar de bestanden op schijf, verstuurt het
# formulier niets en toont het alleen de melding met het mailadres.
#
# Op Vercel staan ze in Settings → Environment Variables. Een wijziging daar
# geldt pas na een nieuwe deploy: een build draagt de waardes mee die er op dát
# moment stonden.

# --- De admin ---------------------------------------------------------------

# Zet de admin om naar GitHub-modus. Moet PUBLIC_ heten omdat keystatic.config.ts
# ook naar de browser wordt gebundeld; daar bestaat `process` niet.
#
# Lokaal leeg laten: daar hoort local mode. Op Vercel hoort hij op `github` te
# staan, en daar dwingt scripts/check-opslag.mjs dat af — zonder valt de admin
# terug op local mode en schrijft hij naar het bestandssysteem van een
# serverless functie, waar het werk van de redacteur bij de volgende deploy weg
# is. Wil je lokaal de GitHub-modus proberen, zet hier dan `github`.
PUBLIC_KEYSTATIC_OPSLAG=

# De drie geheimen van de GitHub App. Keystatic schrijft ze zelf in .env aan het
# eind van de setup-flow — overtypen hoeft niet.
#
# Op Vercel eist check-opslag ze alle drie zodra de opslag op github staat:
# @keystatic/astro zet ze bij de build in de serverbundel, en een geheim dat dan
# ontbreekt laat de admin laden en het inloggen stranden. Om dezelfde reden
# vraagt roteren een nieuwe deploy: tot die er is, draait de bundel met het oude
# geheim.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# De naam van de App zoals GitHub hem in de URL zet. Hiermee kan de admin een
# "installeer de app"-link tonen. Ook deze schrijft de setup-flow zelf.
# check-opslag waarschuwt als hij ontbreekt, maar laat de build niet vallen.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Het formulier ----------------------------------------------------------

# De sleutel waarmee het formulier zijn berichten verstuurt. Aan te maken bij
# Resend; het afzenderdomein moet daar geverifieerd zijn, anders weigert de
# dienst de mail. Zonder deze sleutel valt de build op Vercel om — zie
# scripts/check-resend.mjs — en lokaal wordt er gewoon niets verstuurd.
RESEND_API_KEY=

# De schakelaar van het formulier. Alleen de waarde 'ja' zet hem open; ontbreekt
# hij, dan tonen de secties een korte melding en weigert het endpoint zonder iets
# te versturen. Dat is met opzet geen poortstap: uit is een geldige toestand.
#
# De teksten van het formulier en de aanvulling op de privacyverklaring zijn
# goedgekeurd. Bij de livegang gaat hij op 'ja' voor Production, en daarna
# opnieuw deployen: de secties zijn vooraf gerenderd en lezen hem tijdens de
# build. Zie stap 5 van livegang.md.
FORMULIER_ACTIEF=
