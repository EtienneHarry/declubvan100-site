        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: '',
        knop: { label: 'Alleen een knop', href: '/contact' },
      },
      {
        type: 'beeld-tekst',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: '',
        beeld: BEELD,
      },
      {
        type: 'citaten',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Alleen een bovenkop, geen citaten',
        items: [],
      },
      {
        type: 'drie-kolommen',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: 'Alleen een kop, geen kaarten',
        items: [],
      },
      {
        type: 'accordeon',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: 'Alleen een kop, geen vragen',
        items: [],
      },
      {
        type: 'kop-tekst',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        kop: '',
        tekst: 'Alleen tekst, geen kop.',
      },
    ],
  },
  {
    /*
     * De pijl mag één keer per pagina, en dat is een regel die SectieLijst
     * afdwingt en niet de sectie. Hier vragen drie oproepen erom en krijgt
     * alleen de eerste hem.
     *
     * Zonder dit geval zou een gebroken toekenning er precies zo uitzien als
     * een werkende: er stáát een pijl, en dat hij er drie keer staat merk je
     * alleen als je telt.
     */
    naam: 'pijl · drie vragen erom, alleen de eerste krijgt hem',
    secties: [
      {
        type: 'oproep',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'De eerste',
        kop: 'Deze krijgt de pijl',
        tekst: LOPENDE_TEKST,
        knop: { label: 'Ik zoek personeel', href: '/opdrachtgevers' },
        tweedeKnop: { label: 'Ik wil bij jullie werken', href: '/de-100' },
        pijl: true,
      },
      {
        type: 'oproep',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'De tweede',
        kop: 'Deze vraagt er ook om en krijgt hem niet',
        tekst: LOPENDE_TEKST,
        knop: { label: 'Inhuren', href: '/contact' },
        pijl: true,
      },
      {
        type: 'oproep',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'De derde',
        kop: 'En deze ook niet',
        tekst: LOPENDE_TEKST,
        knop: { label: 'Aanmelden', href: '/de-100' },
