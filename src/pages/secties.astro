  },
  {
    /*
     * De randgevallen van de pijl zelf.
     *
     * Zonder knop is er niets om naar te wijzen; dan hoort hij weg te blijven
     * in plaats van in de leegte te wijzen. En met een lang label breekt de
     * knoptekst over twee regels — dan zegt HaalScript "breekt" en verdwijnt
     * de svg, precies zoals bij een ovaal om een woordgroep die breekt.
     */
    naam: 'pijl · zonder knop, en naast een knop met een lang label',
    secties: [
      {
        type: 'oproep',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Geen knop',
        kop: 'Pijl gevraagd, maar er is geen knop',
        tekst: LOPENDE_TEKST,
        pijl: true,
      },
      {
        type: 'oproep',
        achtergrond: 'bruin',
        ruimte: 'sectie-m',
        breedte: 'basis',
        bovenkop: 'Lang label',
